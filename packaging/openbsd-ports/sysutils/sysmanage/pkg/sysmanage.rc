#!/bin/ksh
#
# $OpenBSD$

# backend.main, not uvicorn directly (Phase 22.2): it binds api.host /
# api.port from sysmanage.yaml -- loopback behind nginx, never 0.0.0.0 -- and
# sizes the workers for this machine.  rc.subr starts it through ``su -l``,
# which clears the environment, so the app directory is the working directory
# (daemon_execdir) instead of a PYTHONPATH export: ``python3 -m`` imports from
# there, and uvicorn's spawned workers inherit the same sys.path.
daemon="${TRUEPREFIX}/bin/python3 -m backend.main"
daemon_user="_sysmanage"
daemon_execdir="${TRUEPREFIX}/libexec/sysmanage"

. /etc/rc.d/rc.subr

rc_bg=YES
rc_reload=NO

rc_cmd $1
