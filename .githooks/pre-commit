#!/usr/bin/env bash
# Pre-commit hook — refuses commits whose staged Python files would be
# reformatted by black, or whose staged CSS files fail stylelint.  This is the upstream-most defense against the
# "black silently rewrote my working tree but I forgot to git add" gap
# that ``make lint``'s auto-fix behaviour can otherwise mask.
#
# Pairs with the ``pre-push`` hook (which runs the full ``make lint``):
#   * pre-commit fires per commit, only on staged .py/.css files, runs
#     ``black --check`` + ``stylelint`` — cheap, fast, blocks bad
#     commits before they even land in history.
#   * pre-push fires once per push, runs the full lint chain — catches
#     anything that slipped through (e.g. ``--no-verify`` commits, or
#     drift introduced by an editor between commit and push).
#
# Behaviour:
#   * No staged .py files under backend/ or tests/   → silent pass.
#   * black --check on staged files passes           → commit proceeds.
#   * black --check fails                            → commit blocked;
#     error tells the dev to run ``make format`` (or ``black backend/
#     tests/``), ``git add`` the result, and re-commit.  Bypass with
#     ``git commit --no-verify`` in a genuine emergency, but the
#     pre-push hook + CI will both reject the same drift later.
#
# This hook is intentionally minimal: it does NOT auto-fix and stage
# the fix, because that would silently include reformat-noise in
# commits the dev didn't intend to touch.  Explicit ``make format``
# + ``git add`` keeps the dev in control.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "${REPO_ROOT}" ]; then
    # Not in a working tree (shouldn't happen for pre-commit, but
    # match the pre-push hook's defensive style).  Let git handle it.
    exit 0
fi
cd "${REPO_ROOT}"

# ---------------------------------------------------------------------------
# CSS: stylelint on staged frontend stylesheets.
#
# Runs BEFORE the Python block on purpose.  That block ends in a bare
# ``exit 0`` and short-circuits with one when nothing Python is staged, so
# anything appended after it would silently never run for a CSS-only commit
# — which is every commit this check exists to catch.
#
# stylelint writes its REPORT to stderr and exits 2, so ``2>/dev/null``
# would throw away the very output the developer needs.  Same trap the
# black check documents above; captured with 2>&1 here for the same reason.
# ---------------------------------------------------------------------------
STAGED_CSS=$(git diff --cached --name-only --diff-filter=ACMR -- \
    'frontend/src/*.css' 'frontend/src/**/*.css' 2>/dev/null || true)

STYLELINT=frontend/node_modules/.bin/stylelint

if [ -n "${STAGED_CSS}" ] && [ ! -x "${STYLELINT}" ]; then
echo ""
echo "[pre-commit] stylelint is NOT INSTALLED."
echo "             Your CSS is fine -- the linter never ran."
echo ""
echo "                 cd frontend && npm ci"
echo ""
exit 1
fi

if [ -n "${STAGED_CSS}" ]; then
set +e
CSS_OUT=$(cd frontend && ./node_modules/.bin/stylelint $(echo "${STAGED_CSS}" | sed 's|^frontend/||') 2>&1)
CSS_RC=$?
set -e
fi

if [ -n "${STAGED_CSS}" ] && [ "${CSS_RC}" -ne 0 ]; then
echo ""
echo "[pre-commit] stylelint found problems in staged CSS."
echo ""
echo "${CSS_OUT}"
echo "             Most rules auto-fix.  Fix locally with:"
echo ""
echo "                 make lint-css-fix    # or: cd frontend && npm run lint:css:fix"
echo "                 git add <files>"
echo "                 git commit"
echo ""
echo "             Bypass with 'git commit --no-verify' if you must,"
echo "             but pre-push and CI both run the same check and"
echo "             will reject it later."
echo ""
exit 1
fi

# Collect staged .py files inside backend/ or tests/.  No staged
# Python under those trees = nothing for this hook to do.
STAGED=$(git diff --cached --name-only --diff-filter=ACMR -- \
    'backend/*.py' 'tests/*.py' \
    'backend/**/*.py' 'tests/**/*.py' 2>/dev/null || true)

if [ -z "${STAGED}" ]; then
    exit 0
fi

# Resolve python from the project venv if present; fall back to
# system python3 (so the hook still works for contributors who
# haven't created a venv yet — they'll see a clear ImportError if
# black isn't installed, which is the right hint).
if [ -x .venv/bin/python ]; then
    PYTHON=.venv/bin/python
elif [ -x .venv/Scripts/python.exe ]; then
    # Windows venv layout.
    PYTHON=.venv/Scripts/python.exe
else
    PYTHON=python3
fi

# Is black actually installed?  ``black --check`` exits non-zero both for real
# formatting drift and for "No module named black", and this hook used to
# discard its output -- so a venv without black produced "black would reformat
# one or more staged Python files" on a tree black had never looked at
# (2026-08-24).  Separate the two before reporting anything.
if ! "${PYTHON}" -c "import black" > /dev/null 2>&1; then
    echo ""
    echo "[pre-commit] black is NOT INSTALLED in ${PYTHON}."
    echo "             Your files are fine -- the formatter never ran."
    echo ""
    echo "                 ${PYTHON} -m pip install -r requirements-dev.txt"
    echo ""
    exit 1
fi

# ``set -e`` is on: capture the status explicitly, or a failing black would
# abort the hook before it could report anything.
set +e
BLACK_OUT="$("${PYTHON}" -m black --check ${STAGED} 2>&1)"
BLACK_RC=$?
set -e

if [ "${BLACK_RC}" -ne 0 ]; then
    echo ""
    echo "[pre-commit] black would reformat one or more staged Python files."
    echo ""
    echo "${BLACK_OUT}"
    echo "             Fix locally with:"
    echo ""
    echo "                 make format        # or: $(echo "${PYTHON}") -m black backend/ tests/"
    echo "                 git add <files>"
    echo "                 git commit"
    echo ""
    echo "             Bypass with 'git commit --no-verify' if you must,"
    echo "             but pre-push and CI both run the same check and"
    echo "             will reject the drift later."
    echo ""
    exit 1
fi

exit 0
