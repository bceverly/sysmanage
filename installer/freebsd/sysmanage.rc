#!/bin/sh

# PROVIDE: sysmanage
# REQUIRE: NETWORKING SERVERS postgresql nginx
# BEFORE: DAEMON
# KEYWORD: shutdown

. /etc/rc.subr

name="sysmanage"
rcvar="sysmanage_enable"
desc="SysManage Server - Centralized system management server"

load_rc_config $name

: ${sysmanage_enable:="NO"}
: ${sysmanage_config:="/usr/local/etc/sysmanage/config.yaml"}
: ${sysmanage_user:="sysmanage"}
: ${sysmanage_group:="sysmanage"}
: ${sysmanage_pidfile:="/var/run/sysmanage/server.pid"}
: ${sysmanage_logfile:="/var/log/sysmanage/server.log"}

# Command to execute
command="/usr/sbin/daemon"
# ``-f`` with ``-o``: stdio to /dev/null first, then output to the log file.
# ``-o`` alone left the supervisor holding the caller's terminal, so
# ``service ... start`` over ssh never returned (reproduced on FreeBSD
# 2026-10-03; with ``-f`` it returns and the log still fills).
command_args="-f -P ${sysmanage_pidfile} -r -t ${name} -o ${sysmanage_logfile} \
    /usr/local/lib/sysmanage/.venv/bin/python -m backend.main"
# backend.main (not uvicorn directly): binds api.host/api.port from the config
# and sizes the workers for this machine (Phase 22.2).

# The server reads the config named here; without it it read
# /etc/sysmanage.yaml, not the file this package writes (2026-11-05).
export SYSMANAGE_CONFIG="${sysmanage_config}"
# Run from the install directory: ``python -m backend.main`` imports the
# app from there and the server writes logs/ beside it.  rc.subr cd's to
# ${name}_chdir before starting; daemon(8) alone starts in /.
sysmanage_chdir="/usr/local/lib/sysmanage"

pidfile="${sysmanage_pidfile}"
required_files="${sysmanage_config}"

start_precmd="${name}_prestart"
stop_postcmd="${name}_poststop"

sysmanage_prestart()
{
	# Create directories if they don't exist
	install -d -o ${sysmanage_user} -g ${sysmanage_group} \
		/var/run/sysmanage /var/log/sysmanage /var/lib/sysmanage

	# Check config file exists
	if [ ! -f "${sysmanage_config}" ]; then
		echo "Configuration file not found: ${sysmanage_config}"
		echo "Copy the example: cp /usr/local/etc/sysmanage/sysmanage.yaml.example ${sysmanage_config}"
		return 1
	fi

	# Check if database is configured
	# Not commented out: a comment mentioning the word used to satisfy this.
	if ! grep -Eq "^(registry|database):" "${sysmanage_config}"; then
		echo "Database not configured in ${sysmanage_config}"
		echo "Please configure the database connection before starting."
		return 1
	fi

	# The package's post-install creates .venv on FreeBSD's own py312
	# packages; it is never rebuilt here.  Migrations are not run here
	# either -- the operator runs scripts/sysmanage_migrate.py, as on every
	# other platform (a bare ``alembic upgrade head`` predates the three
	# migration chains).
	if [ ! -x /usr/local/lib/sysmanage/.venv/bin/python ]; then
		echo "/usr/local/lib/sysmanage/.venv is missing; reinstall the sysmanage package."
		return 1
	fi

	echo "Starting SysManage Server..."
}

sysmanage_poststop()
{
	rm -f ${pidfile}
}

run_rc_command "$1"
