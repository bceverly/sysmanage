#!/bin/sh

# PROVIDE: sysmanage
# REQUIRE: NETWORKING SERVERS postgresql nginx
# BEFORE: DAEMON
# KEYWORD: shutdown

# Add the following lines to /etc/rc.conf to enable sysmanage:
# sysmanage=YES
# sysmanage_config="/usr/pkg/etc/sysmanage/config.yaml"
# sysmanage_user="sysmanage"
# sysmanage_group="sysmanage"

. /etc/rc.subr

name="sysmanage"
rcvar=$name
desc="SysManage Server - Centralized system management server"

load_rc_config $name

: ${sysmanage:="NO"}
: ${sysmanage_config:="/usr/pkg/etc/sysmanage/config.yaml"}
: ${sysmanage_user:="sysmanage"}
: ${sysmanage_group:="sysmanage"}
: ${sysmanage_pidfile:="/var/run/sysmanage/server.pid"}
: ${sysmanage_logfile:="/var/log/sysmanage/server.log"}

# Command to execute
command="/usr/pkg/lib/sysmanage/.venv/bin/python"
# backend.main (not uvicorn directly): it binds api.host/api.port from sysmanage.yaml and sizes the workers for this machine (Phase 22.2)
command_args="-m backend.main"
# rc.subr finds the running server by this name (status / stop).
procname="${command}"
start_cmd="sysmanage_start"
# NetBSD's rc.subr runs ``command`` in the FOREGROUND and expects it to
# daemonize itself; ``python -m backend.main`` does not, so ``service sysmanage start`` never
# returned and no pidfile was written (status and stop could not find the
# process).  Same class of defect as FreeBSD's ``daemon`` without ``-f``
# (2026-10-03).  Start it in the background here, stdin from /dev/null and
# output to the log, and record its pid: ``exec`` keeps that pid the
# Python process's own.  Validated on NetBSD 10.1: the old
# script hung ``service start``; this one returns, and status / restart /
# stop work.
sysmanage_start()
{
	echo "Starting ${name}."
	cd /usr/pkg/lib/sysmanage || return 1
	su -m ${sysmanage_user} -c "exec ${command} ${command_args} \
	    </dev/null >>${sysmanage_logfile} 2>&1 & echo \$! > ${pidfile}"
}

pidfile="${sysmanage_pidfile}"
required_files="${sysmanage_config}"

start_precmd="${name}_prestart"
stop_postcmd="${name}_poststop"

sysmanage_prestart()
{
	# Create directories if they don't exist
	install -d -o ${sysmanage_user} -g ${sysmanage_group} \
		/var/run/sysmanage /var/log/sysmanage /var/lib/sysmanage

	# Check config file exists
	if [ ! -f "${sysmanage_config}" ]; then
		echo "Configuration file not found: ${sysmanage_config}"
		echo "Copy the example: cp /usr/pkg/etc/sysmanage/sysmanage.yaml.example ${sysmanage_config}"
		return 1
	fi

	# Check if database is configured
	if ! grep -q "database:" "${sysmanage_config}"; then
		echo "Database not configured in ${sysmanage_config}"
		echo "Please configure the database connection before starting."
		return 1
	fi

	# Check if virtual environment exists
	if [ ! -d "/usr/pkg/lib/sysmanage/.venv" ]; then
		echo "Python virtual environment not found. Reinstalling dependencies..."
		cd /usr/pkg/lib/sysmanage
		/usr/pkg/bin/python3.12 -m venv .venv
		.venv/bin/pip install --quiet --upgrade pip
		.venv/bin/pip install --quiet -r "$([ -f requirements-prod.txt ] && echo requirements-prod.txt || echo requirements.txt)"
		# The compiled PostgreSQL driver (Phase 22): pkgsrc has no psycopg-c and
		# PyPI no NetBSD wheel, so build it here against the installed libpq.  The
		# pure-Python psycopg calls libpq through ctypes and is several times
		# slower under load; without a compiler or pg_config it stays in use.
		PSYV=$(.venv/bin/python -c "import psycopg; print(psycopg.__version__)" 2>/dev/null)
		if [ -n "$PSYV" ] && { [ -x /usr/pkg/bin/pg_config ] || command -v pg_config >/dev/null 2>&1; }; then
			PATH="/usr/pkg/bin:$PATH" TMPDIR=/var/tmp .venv/bin/pip install --quiet "psycopg-c==$PSYV" \
				|| echo "WARNING: psycopg-c did not build; using the slower pure-Python PostgreSQL driver"
		else
			echo "WARNING: pg_config not found; using the slower pure-Python PostgreSQL driver"
		fi
	fi

	# Run database migrations
	echo "Running database migrations..."
	cd /usr/pkg/lib/sysmanage
	su -m ${sysmanage_user} -c ".venv/bin/python -m alembic upgrade head" || {
		echo "Database migration failed. Please check your database configuration."
		return 1
	}

	echo "Starting SysManage Server..."
}

sysmanage_poststop()
{
	rm -f ${pidfile}
}

run_rc_command "$1"
