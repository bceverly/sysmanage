#!/usr/bin/make -f
# -*- makefile -*-

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

%:
	dh $@

override_dh_auto_clean:
	# Nothing to clean - files are copied via debian/install

override_dh_auto_build:
	# Frontend is built before packaging; backend is copied via debian/install.
	# Generate requirements-prod.txt (runtime-only deps) so debian/install can
	# ship it and the postinst can build the venv from it.  The full
	# requirements.txt carries dev tooling (pylint/astroid/pytest/playwright)
	# which is NOT in the air-gap wheel set, so installing it offline fails.
	python3 scripts/update-requirements-prod.py
	# Stamp the package version into backend/__init__.py so backend.__version__
	# resolves at runtime (server-info + federation "Reported version" show it
	# instead of "unknown").  Strip the Debian revision suffix (e.g. -1).
	printf '__version__ = "%s"\n' "$$(dpkg-parsechangelog -S Version | sed 's/-[^-]*$$//')" > backend/__init__.py

override_dh_auto_test:
	# Skip tests during package build

DEB_HOST_ARCH ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)

override_dh_auto_install:
	# Files are installed via debian/install file
	dh_auto_install
ifeq ($(DEB_HOST_ARCH),riscv64)
	# PyPI has no riscv64 wheels for a dozen of the server's dependencies, and
	# the postinst would have to compile them (four in Rust) during apt
	# install.  CI builds them (.github/workflows/riscv64-wheels.yml) into the
	# source upload; ship them, and refuse to build a riscv64 package that
	# could not install.
	test -n "$$(ls riscv64-wheels/*.whl 2>/dev/null)" || \
		{ echo "riscv64-wheels/ is empty: see riscv64-wheels.yml" >&2; exit 1; }
	install -d debian/sysmanage/opt/sysmanage/wheels
	install -m 644 riscv64-wheels/*.whl debian/sysmanage/opt/sysmanage/wheels/
endif

override_dh_installinit:
	dh_installinit -psysmanage --name=sysmanage --no-start

override_dh_installsystemd:
	dh_installsystemd -psysmanage --name=sysmanage --no-start --no-enable
	# Phase 22.9: the canary is not enabled or started on install -- it needs
	# its configuration first (the postinst says how).
	dh_installsystemd -psysmanage-canary --name=sysmanage-canary --no-start --no-enable
