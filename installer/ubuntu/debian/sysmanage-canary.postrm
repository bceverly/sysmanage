set -e

if [ "$1" = "purge" ]; then
	rm -f /etc/sysmanage-canary.yaml
	if getent passwd sysmanage-canary >/dev/null; then
		deluser --system sysmanage-canary >/dev/null 2>&1 || true
	fi
fi

#DEBHELPER#

exit 0
