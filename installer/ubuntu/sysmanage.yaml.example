---
# SysManage Server Configuration
#
# This file should be copied to /etc/sysmanage.yaml and customized for
# your environment.
#
# For a fully-populated example with every option, see the canonical
# template at the top of the source tree (sysmanage.yaml.example) or
# the online config builder at https://sysmanage.org/config-builder.html

# Backend HTTP API.  Nginx (port 3000) reverse-proxies /api/* and /ws to
# this socket.  Keep host=localhost — every backend route now lives under
# /api so external clients reach the backend only through nginx; there's
# no reason to expose the raw uvicorn port.
# Development mode.
#
# ABSENT OR FALSE = production, which is the safe default: nginx terminates TLS
# on 443 (port 80 only redirects to it), and links in invitation and
# password-reset emails are https://<host> with no port.
#
# TRUE = a development box with no reverse proxy and no certificate: the UI is
# the Vite server on webui.port, the backend is on api.port, and emailed links
# become http://<host>:<webui.port>.
#
# Left out on purpose in every shipped template. A missing or misspelt flag
# must fail towards TLS -- the worst case there is a link that redirects,
# whereas defaulting the other way would let a forgotten line downgrade a real
# deployment to plaintext.
#
# dev_mode: true

api:
  # Bind LOOPBACK only. nginx terminates TLS on 443 and reaches the API here,
  # so this port never needs to face the network: the whole external surface is
  # 80/443, which is also all an agent needs (outbound 443, nothing inbound).
  #
  # A wildcard such as 0.0.0.0 publishes the API directly, bypassing nginx and
  # therefore its TLS, security headers and upgrade validation. Agent
  # registration is unauthenticated by design, so that exposes an open
  # enrollment endpoint in cleartext. The server warns loudly at startup if you
  # do this.
  #
  # Legitimate exceptions exist (development without a reverse proxy, a
  # container publishing its own port, TLS terminated elsewhere). Set
  # allow_public_bind to record that the decision was deliberate:
  #   allow_public_bind: true
  host: "localhost"
  port: 8080

# Database connection (PostgreSQL required).
database:
  user: "sysmanage"
  password: "CHANGE_ME_IN_PRODUCTION"   # ⚠ change this
  host: "localhost"
  port: 5432
  name: "sysmanage"
  # Optional: ssl_mode: "prefer"  # disable|allow|prefer|require|verify-ca|verify-full

# Authentication and JWT signing.
security:
  password_salt: "CHANGE_ME_IN_PRODUCTION_USE_RANDOM_STRING"   # ⚠ change this
  # MUST be an email address: the login endpoint declares userid as
  # pydantic EmailStr, so a bare "admin" is rejected with HTTP 422
  # before the password is ever checked.  The old default could never
  # log in on any platform.
  admin_userid: "admin@example.com"
  admin_password: "admin"   # ⚠ change this on first login
  jwt_secret: "CHANGE_ME_IN_PRODUCTION_USE_RANDOM_SECRET"   # ⚠ change this
  jwt_algorithm: "HS256"
  jwt_auth_timeout: 600
  jwt_refresh_timeout: 60000

# Web UI host/port.  Nginx serves the static frontend on this port and
# reverse-proxies /api/* to the backend on api.port above.
webui:
  host: "localhost"
  port: 3000

logging:
  level: "INFO"   # DEBUG | INFO | WARNING | ERROR | CRITICAL
  format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"

# Multi-tenancy (Phase 13.1) — OPT-IN. Leave disabled for single-tenant /
# homelab / on-prem installs (the default: one implicit tenant). Enable only to
# run a SaaS control plane hosting isolated tenants (one database per tenant).
# See the canonical sysmanage.yaml.example for the accompanying registry: and
# backup: blocks that go with SaaS mode.
multitenancy:
  enabled: false
  self_service_provisioning: false

# Pro+ license (optional — leave key empty for the Community Edition)
license:
  key: ""
  phone_home_url: "https://license.sysmanage.io"
  phone_home_interval_hours: 24
  modules_path: "/var/lib/sysmanage/modules"

# OpenBAO / Vault integration (optional)
# openbao:
#   enabled: false
#   address: "http://localhost:8200"
#   token: ""

# OpenTelemetry (optional)
# telemetry:
#   enabled: false
#   endpoint: "http://localhost:4317"
