#
# sysmanage-canary: an outside watcher for a SysManage server (Phase 22.9).
# Deliberately NOT tied to sysmanage.service: it must keep running when the
# server is down -- that is when it is needed.
[Unit]
Description=SysManage canary (outside watcher for the SysManage server)
Documentation=https://sysmanage.org/docs/deployment/best-practices.html
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sysmanage-canary
Group=sysmanage-canary
ExecStartPre=/usr/bin/sysmanage-canary --config /etc/sysmanage-canary.yaml --check-config
ExecStart=/usr/bin/sysmanage-canary --config /etc/sysmanage-canary.yaml
Restart=always
RestartSec=30
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes

[Install]
WantedBy=multi-user.target
