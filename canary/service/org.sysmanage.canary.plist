     sysmanage-canary (Phase 22.9) as a launchd daemon:
       sudo launchctl bootstrap system /Library/LaunchDaemons/org.sysmanage.canary.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>org.sysmanage.canary</string>
  <key>ProgramArguments</key><array>
    <string>/usr/local/bin/sysmanage-canary</string>
    <string>--config</string><string>/usr/local/etc/sysmanage-canary.yaml</string>
  </array>
  <key>UserName</key><string>_sysmanage_canary</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/usr/local/var/log/sysmanage-canary.log</string>
  <key>StandardErrorPath</key><string>/usr/local/var/log/sysmanage-canary.log</string>
</dict></plist>
